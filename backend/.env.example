SERVER_PORT=26372
API_BASE_URL=http://localhost:26372/api
CORS_ALLOWED_ORIGINS=http://localhost:26371,http://127.0.0.1:26371

# Managed by Eco from storage.minio; this domain is the only S3 client.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=stuff8-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Upload limits, configurable per estate.
MAX_IMAGE_MB=10
MAX_DOCUMENT_MB=50
MAX_IMAGE_PIXELS=40000000
# Videos are re-encoded to MP4 (H.264/AAC) by ffmpeg before storage.
MAX_VIDEO_MB=200
